# Supabase production: use the pooled PostgreSQL connection string (port 6543).
DATABASE_URL=postgres://convertly:convertly@localhost:5432/convertly

# Redis (for job queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 Storage (AWS or compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=convertly-files
S3_ACCESS_KEY=convertly
S3_SECRET_KEY=convertly-local-secret
# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Convertly

# File Encryption (32-byte key as 64 hexadecimal characters)
FILE_ENCRYPTION_KEY=

# OpenRouter AI API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free

# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Harici LibreOffice/OCR servisi (Vercel'de ikisi de gereklidir)
CONVERSION_SERVICE_URL=
CONVERSION_SERVICE_TOKEN=
