{
  "name": "converter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "predev": "npm run prepare:conversion-assets",
    "build": "next build",
    "prebuild": "npm run prepare:conversion-assets",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm run prepare:conversion-assets",
    "prepare:conversion-assets": "node scripts/prepare-conversion-assets.mjs",
    "docker:build": "docker build -t convertly .",
    "docker:run": "docker compose up app --build",
    "db:generate": "drizzle-kit generate",
    "infra:up": "docker compose up -d postgres minio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imgly/background-removal": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "gifenc": "^1.0.3",
    "heic2any": "^0.0.4",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.2",
    "next": "16.3.3",
    "onnxruntime-web": "^1.21.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
